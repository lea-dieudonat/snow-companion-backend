# Copier ce fichier en .env et adapter les valeurs. Ne jamais commiter .env.

# --- Serveur ---
PORT=3001
# development | test | production
NODE_ENV=development

# --- HTTP ---
# Origine(s) autorisées par CORS, séparées par des virgules. Obligatoire en production.
# Par défaut en développement : http://localhost:3000
# CORS_ORIGIN=https://sillon.example
# Nombre de reverse proxys de confiance devant l'API (0 = désactivé)
TRUST_PROXY=0

# --- Base de données ---
DATABASE_URL="postgresql://user:password@localhost:5432/snow_companion?schema=public"
# Base dédiée aux tests (utilisée par Vitest, migrée et seedée automatiquement)
DATABASE_URL_TEST="postgresql://user:password@localhost:5432/snow_companion_test?schema=public"

# --- Authentification ---
# 32 caractères minimum en production (ex : openssl rand -hex 32)
JWT_SECRET="change-me-to-a-long-random-secret-of-32-chars-min"
JWT_EXPIRES_IN="7d"

# --- Agent IA (Snow Planner) ---
# Valeur factice : remplacer par une vraie clé pour utiliser l'agent
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx"
AGENT_MODEL_SYNTHESIS=claude-sonnet-4-6
AGENT_MODEL_TOOLS=claude-haiku-4-5-20251001
AGENT_MAX_ITERATIONS=5
AGENT_MAX_TOKENS=1024
AGENT_TIMEOUT_MS=30000
# Fenêtre (ms) et nombre max de requêtes agent par fenêtre
AGENT_RATE_LIMIT_WINDOW_MS=60000
AGENT_RATE_LIMIT_MAX=10

# --- Rate-limit (fenêtre en ms, nombre max de requêtes par IP et par fenêtre) ---
# /auth/login et /auth/register
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
# /stations
STATIONS_RATE_LIMIT_WINDOW_MS=60000
STATIONS_RATE_LIMIT_MAX=120

# --- Seed (npx prisma db seed) ---
# Compte démo (demo@snowcompanion.app) : créé seulement si NODE_ENV != production
# ou SEED_DEMO=true, et seulement si SEED_DEMO_PASSWORD est défini.
# SEED_DEMO=true
SEED_DEMO_PASSWORD="choisir-un-mot-de-passe-demo"

# --- Tâches planifiées (synchro des stations) ---
# true : ce processus exécute les crons (défaut). false : à mettre sur les instances web
# quand un worker dédié tourne (npm run start:worker).
RUN_CRONS=true
